{
  "name": "argon-friend-link-checker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "ipaddr.js": "^2.4.0",
    "tldts": "^7.4.9"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types --include-runtime false --env-interface WorkerBindings",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "wrangler types --include-runtime false --env-interface WorkerBindings --check && tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@types/node": "^24.0.0",
    "miniflare": "^4.20260722.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
