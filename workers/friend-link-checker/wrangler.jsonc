{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "neutral-link-checker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "worker.cartol.top",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://blog.cartol.top",
    "SITE_URL": "https://blog.cartol.top",
    "CALLBACK_URL": "https://blog.cartol.top/wp-json/argon/v1/friend-link-result"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "friend-links",
      "database_id": "14452365-ea72-435f-8475-dc207f575142",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CHECK_QUEUE",
        "queue": "friend-link-checks"
      }
    ],
    "consumers": [
      {
        "queue": "friend-link-checks",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "triggers": {
    "crons": ["17 * * * *"]
  }
}
